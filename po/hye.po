#, c-format
msgid ""
"%s is missing.\n"
"\n"
"You do not have a decoder installed to handle this file.\n"
"Probably you need to look at the gst-plugins-* packages\n"
"for the necessary plugins.\n"
msgstr "%s բացակայում է.\n\nԱյս նիշքը կարգաւորելու համար Դուք չունէք ապակոդաւորիչ:\nՀաւանաբար, Դուք պէտք է նայէք gst-plugins- *- ի փաթեթներին\nանհրաժեշտ ներդրաւների համար:\n"

