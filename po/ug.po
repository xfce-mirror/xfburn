#: xfburn/xfburn-transcoder-gst.c:147
#, c-format
msgid ""
"%s is missing.\n"
"\n"
"You do not have a decoder installed to handle this file.\n"
"Probably you need to look at the gst-plugins-* packages\n"
"for the necessary plugins.\n"
msgstr "%s يوقالغان.\n\nبۇ تىپتىكى ھۆججەتنى بىر تەرەپ قىلىدىغان كود يەشكۈچ يوق.\nكېرەكلىك كود يەشكۈچنى gst-plugins-* بوغچىسىدىن\nئورنىتىشقا بولىدۇ.\n"

